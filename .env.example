# Public site origin used for canonical/OG URLs and sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://samaanbol.space

# --- SEO: Search engine verification (optional) ---
# Use only if you verified via HTML-tag method instead of DNS/domain property.
# Google Search Console: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: https://www.bing.com/webmasters
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Analytics ---
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- IndexNow (server-only) ---
# Key generated at https://www.bing.com/indexnow. The same value must exist at
# /public/{INDEXNOW_KEY}.txt for ownership verification.
INDEXNOW_KEY=
